# 普通配送统一费率（人民币，非负数字，最多两位小数）。空白时 Checkout 会安全拦截。
ORBITAL_STANDARD_SHIPPING_FEE=

# Medusa Store API (the publishable key is intentionally usable by the storefront)
MEDUSA_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
# Configure only after deciding target country/currency and creating its Medusa region.
MEDUSA_REGION_ID=
